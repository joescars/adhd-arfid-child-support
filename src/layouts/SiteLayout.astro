---
const { title = 'ADHD + ARFID Child Support', description = 'Evidence-aware resources for parents and caregivers.', noindex = false } = Astro.props;
const canonicalUrl = new URL(Astro.url.pathname, Astro.site ?? 'https://adhdandarfid.com');
const pages = [
  { href: '/next-step/', label: 'Next step' },
  { href: '/04-who-can-help/', label: 'Who can help' },
  { href: '/resources/', label: 'Resources' },
  { href: '/safety/red-flags-and-urgent-help/', label: 'Urgent help', urgent: true },
];
import '../styles/site.css';
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta name="description" content={description} />
    {noindex ? <meta name="robots" content="noindex, follow" /> : <link rel="canonical" href={canonicalUrl.href} />}
    <title>{title} | ADHD + ARFID Child Support</title>
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to content</a>
    <header class="site-header">
      <div class="shell header-inner">
        <a class="brand" href="/" aria-label="ADHD and ARFID Child Support home">
          <span class="brand-name">ADHD <span aria-hidden="true">+</span> ARFID</span>
          <span class="brand-subtitle">Child Support</span>
        </a>
        <nav class="primary-nav" aria-label="Primary navigation">
          {pages.map((page) => (
            <a href={page.href} class:list={[{ 'nav-urgent': page.urgent }]} aria-current={Astro.url.pathname === page.href ? 'page' : undefined}>{page.label}</a>
          ))}
        </nav>
      </div>
    </header>
    <main id="main-content" class="shell">
      <slot />
    </main>
    <footer class="site-footer">
      <div class="shell footer-inner">
        <div class="footer-copy">
          <p>General education—not diagnosis or individualized medical advice.</p>
          <p class="copyright">© {new Date().getFullYear()} ADHD + ARFID Child Support</p>
        </div>
        <nav class="footer-nav" aria-label="Footer navigation">
          <a href="/safety/red-flags-and-urgent-help/">Safety and urgent help</a>
          <a href="/contact/">Contact</a>
          <a href="/disclaimer/">Disclaimer</a>
        </nav>
      </div>
    </footer>
  </body>
</html>
