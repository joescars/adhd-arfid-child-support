---
import SiteLayout from '../layouts/SiteLayout.astro';

const concernRoutes = [
  { title: 'Food range or intake is shrinking', summary: 'Nutrition, hydration, growth, and accepted foods', href: '/nutrition/nutrition-hydration-growth/' },
  { title: 'Mealtimes are distressed or fear-driven', summary: 'Distress, anxiety, and feeding concerns', href: '/mental-health/anxiety-and-overlap/' },
  { title: 'Eating may be painful', summary: 'Gastrointestinal symptoms and feeding', href: '/feeding/gastrointestinal-symptoms/' },
  { title: 'Chewing, swallowing, coughing, or choking is a concern', summary: 'Feeding and swallowing support', href: '/04-who-can-help/' },
  { title: 'ADHD treatment may affect appetite or sleep', summary: 'Questions to take to the prescriber', href: '/adhd/medication-appetite-sleep/' },
  { title: 'School, lunch, or transitions are the main problem', summary: 'School supports, daily life, and printable worksheets', href: '/06-school-and-daily-life/' },
];
---
<SiteLayout title="Find a next step" description="Choose a concern to find a safe next step for your child. No diagnosis is needed to begin.">
  <div class="home-page">
    <section class="home-intro" aria-labelledby="home-title">
      <h1 id="home-title">What’s happening with your child?</h1>
      <p>Start with the concern that feels closest. You don’t need a diagnosis to find a helpful next step.</p>
    </section>

    <a class="urgent-route" href="/safety/red-flags-and-urgent-help/" aria-label="Urgent help: review emergency and prompt-care signs">
      <span class="urgent-mark" aria-hidden="true">!</span>
      <span class="urgent-copy"><strong>Something may be urgent?</strong><span>Review emergency signs and when to contact a clinician promptly.</span></span>
      <span class="urgent-arrow" aria-hidden="true">→</span>
    </a>

    <section aria-labelledby="concern-heading">
      <div class="concern-heading">
        <h2 id="concern-heading">Choose the concern closest to what you’re seeing</h2>
        <p>Each link opens guidance and questions to consider.</p>
      </div>
      <div class="concern-list">
        {concernRoutes.map((route) => (
          <a class="concern-link" href={route.href}>
            <span><strong>{route.title}</strong><small>{route.summary}</small></span>
            <span class="concern-arrow" aria-hidden="true">→</span>
          </a>
        ))}
      </div>
    </section>

    <p class="home-disclaimer">General education—not diagnosis or individualized treatment advice. <a href="/disclaimer/">Read the safety disclaimer.</a></p>

    <section aria-label="Other ways to get support" class="support-shortcuts">
      <a href="/04-who-can-help/"><strong>Who can help?</strong><span>Understand professional roles and what to ask when seeking care. <span class="shortcut-arrow" aria-hidden="true">→</span></span></a>
      <a href="/05-prepare-for-care/"><strong>Prepare for care</strong><span>Organize questions for a clinician or school conversation. <span class="shortcut-arrow" aria-hidden="true">→</span></span></a>
      <a href="/06-school-and-daily-life/"><strong>School and daily life</strong><span>Find starting points for school, routines, and transitions. <span class="shortcut-arrow" aria-hidden="true">→</span></span></a>
    </section>

    <p class="library-note">Looking for a specific service or topic? <a href="/resources/">Browse the resource library</a>.</p>
  </div>
</SiteLayout>
