---
import SiteLayout from '../layouts/SiteLayout.astro';

const concernRoutes = [
  { category: 'Eating', title: 'Food range or intake is shrinking', summary: 'Nutrition, hydration, growth, and accepted foods', href: '/nutrition/nutrition-hydration-growth/' },
  { category: 'Mealtimes', title: 'Meals feel distressed or fear-driven', summary: 'Anxiety, distress, and overlapping concerns', href: '/mental-health/anxiety-and-overlap/' },
  { category: 'Pain', title: 'Eating may be painful', summary: 'Gastrointestinal symptoms and feeding', href: '/feeding/gastrointestinal-symptoms/' },
  { category: 'Safety', title: 'Chewing or swallowing feels uncertain', summary: 'Feeding and swallowing support', href: '/04-who-can-help/' },
  { category: 'ADHD care', title: 'Appetite or sleep changed with treatment', summary: 'Questions to take to the prescriber', href: '/adhd/medication-appetite-sleep/' },
  { category: 'School', title: 'School, lunch, or transitions are hard', summary: 'School support, daily life, and printables', href: '/06-school-and-daily-life/' },
];

const topicRoutes = [
  { title: 'ADHD', href: '/adhd/overview/' },
  { title: 'ARFID', href: '/arfid/overview/' },
  { title: 'ADHD and ARFID together', href: '/cross-cutting/adhd-arfid/' },
];
---
<SiteLayout title="A place to start" description="Caregiver-friendly information about ADHD, ARFID, and both. Find concern-led guidance, practical questions, and resources without needing a diagnosis first.">
  <div class="home-page">
    <section class="home-intro" aria-labelledby="home-title">
      <h1 id="home-title">ADHD, ARFID, or both?</h1>
      <p>Caregiver-friendly guides and practical questions to help you explore what comes next—without needing a diagnosis first.</p>
      <p class="home-intro-note">General education, not a diagnosis or individualized care.</p>
    </section>

    <a class="urgent-route" href="/safety/red-flags-and-urgent-help/">
      <span class="urgent-mark" aria-hidden="true">!</span>
      <span class="urgent-copy"><strong>Worried something may be urgent?</strong><span>See emergency, prompt-care, and routine guidance. If there is immediate danger, use local emergency services.</span></span>
      <span class="urgent-arrow" aria-hidden="true">Read urgent-help guidance</span>
    </a>

    <section class="concern-section" aria-labelledby="concern-heading">
      <div class="concern-heading">
        <h2 id="concern-heading">What’s been hardest lately?</h2>
        <p>You don’t need the perfect words. Start where it feels useful—you can explore more than one.</p>
      </div>
      <div class="concern-list">
        {concernRoutes.map((route) => (
          <a class="concern-link" href={route.href}>
            <span class="concern-category">{route.category}</span>
            <span class="concern-copy"><strong>{route.title}</strong><small>{route.summary}</small></span>
            <span class="concern-arrow" aria-hidden="true"></span>
          </a>
        ))}
      </div>
    </section>

    <section class="topic-section" aria-labelledby="topics-heading">
      <div class="section-heading">
        <h2 id="topics-heading">Or start with a topic</h2>
        <p>Plain-language introductions, with sources and limits to help you read in context.</p>
      </div>
      <nav class="topic-links" aria-label="Topic guides">
        {topicRoutes.map((topic) => <a href={topic.href}>{topic.title}</a>)}
      </nav>
    </section>

    <section class="care-conversation" aria-labelledby="conversation-heading">
      <div class="conversation-image">
        <img src="/images/research-worksheets.webp" alt="Blank worksheets, a pencil, colored cards, and a magnifying glass arranged on a softly lit desk." width="1536" height="1024" loading="lazy" decoding="async" />
        <p>Space to gather your questions, at your own pace.</p>
      </div>
      <div class="conversation-copy">
        <h2 id="conversation-heading">A few questions can help you get started</h2>
        <ul>
          <li>What should we assess first?</li>
          <li>Who could help, and who will coordinate care?</li>
          <li>What changes mean we should call sooner?</li>
        </ul>
        <a class="text-link" href="/05-prepare-for-care/">Prepare questions for a care conversation</a>
      </div>
    </section>

    <section class="support-section" aria-labelledby="support-heading">
      <div class="section-heading">
        <h2 id="support-heading">Find the kind of support you need</h2>
        <p>Professional roles, school support, and local services can vary. These guides help you know what to ask.</p>
      </div>
      <div class="support-shortcuts">
        <a href="/04-who-can-help/"><strong>Who can help?</strong><span>Explore professional roles, provider fit, and referral questions.</span></a>
        <a href="/06-school-and-daily-life/"><strong>School and daily life</strong><span>Find starting points for school, lunch, routines, and transitions.</span></a>
        <a href="/resources/"><strong>Resource library</strong><span>Browse official, clinical, and caregiver resources by topic.</span></a>
      </div>
    </section>

    <aside class="home-boundaries" aria-label="How to use this site safely">
      <h2>Use this site as a starting point</h2>
      <p>These pages offer general education. They cannot establish a diagnosis or decide what care is right for an individual child. Keep clinician-directed care in place; don’t start or change treatment based on a webpage. If safety, eating, swallowing, hydration, growth, or distress worries you, use the <a href="/safety/red-flags-and-urgent-help/">red-flags and urgent-help guide</a> or contact the child’s care team.</p>
      <p class="home-source-note">Topic pages link their sources and describe scope and limitations. <a href="/disclaimer/">Read the full health and safety disclaimer.</a></p>
    </aside>
  </div>
</SiteLayout>
